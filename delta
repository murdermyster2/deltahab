local Roles = {}
local roleCache = {}

local Remotes = ReplicatedStorage:WaitForChild("Remotes", 10)
local Extras, Gameplay = nil, nil
if Remotes then
    Extras = Remotes:FindFirstChild("Extras")
    Gameplay = Remotes:FindFirstChild("Gameplay")
end
local GetPlayerData = Extras and Extras:FindFirstChild("GetPlayerData")
local PlayerDataChanged = Gameplay and Gameplay:FindFirstChild("PlayerDataChanged")

local function applyRoleData(data)
    if type(data) ~= "table" then return end
    for name, info in pairs(data) do
        local plr = Players:FindFirstChild(name)
        if plr and type(info) == "table" and info.Role then
            roleCache[plr.UserId] = info.Role
        end
    end
end

function Roles.refresh()
    if not GetPlayerData then return end
    local ok, data = pcall(function()
        return GetPlayerData:InvokeServer()
    end)
    if ok and data then applyRoleData(data) end
end

function Roles.getFor(player)
    if not player then return nil end
    return roleCache[player.UserId]
end

if PlayerDataChanged then
    PlayerDataChanged.OnClientEvent:Connect(applyRoleData)
end
Roles.refresh()

Players.PlayerAdded:Connect(function() task.wait(1); Roles.refresh() end)
Players.PlayerRemoving:Connect(function(plr) roleCache[plr.UserId] = nil end)

task.spawn(function()
    while task.wait(5) do Roles.refresh() end
end)

