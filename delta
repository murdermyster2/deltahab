local function listConfigs()
    if not listfiles then return { "No configs" } end
    local out = {}
    for _, path in ipairs(listfiles(CONFIG_FOLDER)) do
        local name = path:gsub("\\", "/"):match("([^/]+)" .. CONFIG_EXT .. "$")
        if name then table.insert(out, name) end
    end
    if #out == 0 then table.insert(out, "No configs") end
    return out
end

