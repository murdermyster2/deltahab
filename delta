local function applyForceField()
    if not Visuals.Settings.forceFieldEnabled then return end
    local char = Context.getCharacter()
    if not char then return end
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            local insideTool = false
            local p = part.Parent
            while p and p ~= char do
                if p:IsA("Tool") then insideTool = true; break end
                p = p.Parent
            end
            if not insideTool then
                part.Material = Enum.Material.ForceField
                part.Color = Visuals.Settings.forceFieldColor
            end
        end
    end
end

local function createChinaHat()
    for _, obj in ipairs(chinaHatParts) do
        pcall(function() obj:Destroy() end)
    end
    chinaHatParts = {}
    if not Visuals.Settings.chinaHatEnabled then return end
    local char = Context.getCharacter()
    if not char then return end
    local head = char:FindFirstChild("Head")
    if not head then return end

    local part = Instance.new("Part")
    part.Name = "DeltaChinaHat"
    part.Size = Vector3.new(1, 1, 1)
    part.Color = Visuals.Settings.chinaHatColor
    part.Material = Enum.Material.Neon
    part.Transparency = 0.2
    part.CanCollide = false
    part.Anchored = false
    part.Parent = char
    table.insert(chinaHatParts, part)

    local mesh = Instance.new("SpecialMesh")
    mesh.MeshType = Enum.MeshType.FileMesh
    mesh.MeshId = "rbxassetid://1033714"
    mesh.Scale = Vector3.new(1.7, 1.1, 1.7)
    mesh.Parent = part
    table.insert(chinaHatParts, mesh)

    local weld = Instance.new("Weld")
    weld.Part0 = head
    weld.Part1 = part
    weld.C0 = CFrame.new(0, 0.9, 0)
    weld.Parent = part
    table.insert(chinaHatParts, weld)
end

local function updateWatermark()
    if not Visuals.Settings.watermarkEnabled then
        if watermarkTexts then
            for _, t in ipairs(watermarkTexts) do pcall(function() t:Remove() end) end
            watermarkTexts = nil
        end
        return
    end
    if not Drawing then return end
    if not watermarkTexts then
        watermarkTexts = {}
        watermarkTexts[1] = Drawing.new("Text")
        watermarkTexts[1].Text = "delta"
        watermarkTexts[1].Size = 18
        watermarkTexts[1].Color = Color3.fromRGB(140, 200, 255)
        watermarkTexts[1].Outline = true
        watermarkTexts[1].Visible = true
        watermarkTexts[1].Font = 3

        watermarkTexts[2] = Drawing.new("Text")
        watermarkTexts[2].Text = "hub"
        watermarkTexts[2].Size = 18
        watermarkTexts[2].Color = Color3.fromRGB(0, 170, 255)
        watermarkTexts[2].Outline = true
        watermarkTexts[2].Visible = true
        watermarkTexts[2].Font = 3

        watermarkTexts[3] = Drawing.new("Text")
        watermarkTexts[3].Size = 14
        watermarkTexts[3].Outline = true
        watermarkTexts[3].Visible = true
        watermarkTexts[3].Font = 3
    end
    local t1, t2, t3 = watermarkTexts[1], watermarkTexts[2], watermarkTexts[3]
    if not (t1 and t2 and t3) then return end
    local vp = workspace.CurrentCamera.ViewportSize
    local bounds1 = t1.TextBounds
    local bounds2 = t2.TextBounds
    local totalW = bounds1.X + bounds2.X + 4
    local base = Vector2.new(vp.X / 2 - totalW / 2, vp.Y / 2 - 9)
    t1.Position = base
    t2.Position = base + Vector2.new(bounds1.X + 4, 0)
    local safe = Context.State.voidHideEnabled
    t3.Text = safe and "Safe" or "Unsafe"
    t3.Color = safe and Color3.fromRGB(0, 255, 0) or Color3.fromRGB(255, 0, 0)
    t3.Position = base + Vector2.new(0, 20)
end

