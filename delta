            end
        else
            Window:Notify({ Title = "Ошибка", Description = tostring(err), Duration = 3 })
        end
    end,
})

Window:AddButton({
    Title = "Load Config",
    Tab = SettingsTab,
    Callback = function()
        if not readfile then return end
        local path = CONFIG_FOLDER .. "/" .. currentConfig .. CONFIG_EXT
        if not (isfile and isfile(path)) then
            Window:Notify({ Title = "Ошибка", Description = "Не найдено", Duration = 2 })
            return
        end
        local ok, data = pcall(function()
            return game:GetService("HttpService"):JSONDecode(readfile(path))
        end)
        if ok and data then
            applySettings(data)
            Window:Notify({ Title = "Загружено", Description = currentConfig, Duration = 2 })
        end
    end,
})

