local ESP = {}
ESP.Settings = {
    enabled = false,
    showMurderer = true,
    showSheriff = true,
    showInnocent = false,
    showHero = true,
    showNames = true,
}
ESP.Colors = {
    Murderer = Color3.fromRGB(255, 60, 60),
    Sheriff  = Color3.fromRGB(60, 160, 255),
    Innocent = Color3.fromRGB(120, 220, 255),
    Hero     = Color3.fromRGB(255, 220, 100),
}
local espActive = {}

local function shouldShow(role)
    if role == "Murderer" then return ESP.Settings.showMurderer end
    if role == "Sheriff"  then return ESP.Settings.showSheriff  end
    if role == "Innocent" then return ESP.Settings.showInnocent end
    if role == "Hero"     then return ESP.Settings.showHero     end
    return false
end

local function createNameBillboard(player, color)
    local char = player.Character
    if not char then return nil end
    local head = char:FindFirstChild("Head")
    if not head then return nil end

    local bb = Instance.new("BillboardGui")
    bb.Name = "DeltaHubNameESP"
    bb.AlwaysOnTop = true
    bb.Size = UDim2.new(0, 200, 0, 30)
    bb.StudsOffset = Vector3.new(0, 2.5, 0)
    bb.Parent = head

    local label = Instance.new("TextLabel")
    label.BackgroundTransparency = 1
    label.Size = UDim2.new(1, 0, 1, 0)
    label.Font = Enum.Font.GothamBold
    label.TextSize = 14
    label.TextStrokeTransparency = 0
    label.TextStrokeColor3 = Color3.new(0, 0, 0)
    label.TextColor3 = color
    label.Text = player.Name
    label.Parent = bb
    return bb
end

local function clearPlayerESP(player)
    local data = espActive[player]
    if not data then return end
    if data.highlight then data.highlight:Destroy() end
    if data.billboard then data.billboard:Destroy() end
    espActive[player] = nil
end

local function applyPlayerESP(player)
    if player == Players.LocalPlayer then return end
    local role = Roles.getFor(player)
    if not role then return end

    local existing = espActive[player]

    if not shouldShow(role) or not player.Character then
        clearPlayerESP(player)
        return
    end

    local color = ESP.Colors[role] or Color3.new(1, 1, 1)
    local char = player.Character

    local hl = char:FindFirstChild("DeltaHubESP")
    if not hl then
        hl = Instance.new("Highlight")
        hl.Name = "DeltaHubESP"
        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        hl.FillTransparency = 0.5
        hl.OutlineTransparency = 0
        hl.Parent = char
    end
    hl.FillColor = color
    hl.OutlineColor = color

    if existing and existing.highlight and existing.highlight.Parent ~= char then
        clearPlayerESP(player)
    end

    local bb = nil
    if ESP.Settings.showNames then
        local head = char:FindFirstChild("Head")
        if head and not head:FindFirstChild("DeltaHubNameESP") then
            bb = createNameBillboard(player, color)
        else
            bb = existing and existing.billboard or nil
            if bb then
                local lbl = bb:FindFirstChildOfClass("TextLabel")
                if lbl then lbl.TextColor3 = color end
            end
        end
    end

    espActive[player] = { highlight = hl, billboard = bb }
end

function ESP.start(context)
    ESP.Settings.enabled = true

    Connection.newTagged(context, "esp", RunService.Heartbeat, function()
        if not ESP.Settings.enabled then return end
        for _, plr in ipairs(Players:GetPlayers()) do
            Logger.try("ESP.apply", applyPlayerESP, plr)
        end
    end)

    for _, plr in ipairs(Players:GetPlayers()) do
        Connection.newTagged(context, "esp", plr.CharacterAdded, function()
            task.wait(0.3)
            Logger.try("ESP.apply", applyPlayerESP, plr)
        end)
    end

    Connection.newTagged(context, "esp", Players.PlayerAdded, function(plr)
        plr.CharacterAdded:Connect(function()
            task.wait(0.3)
            Logger.try("ESP.apply", applyPlayerESP, plr)
        end)
    end)

    Connection.newTagged(context, "esp", Players.PlayerRemoving, function(plr)
        clearPlayerESP(plr)
    end)
end

function ESP.stop(context)
    ESP.Settings.enabled = false
    Connection.disconnectTag("esp")
    for plr in pairs(espActive) do clearPlayerESP(plr) end
end

