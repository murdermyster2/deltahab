local function skidFling(target)
    local myChar = Context.getCharacter()
    local myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")
    local myRoot = myHum and myHum.RootPart
    local targetChar = target.Character
    if not targetChar or not myRoot then return end

    local targetHum = targetChar:FindFirstChildOfClass("Humanoid")
    local targetRoot = targetHum and targetHum.RootPart
    if not targetRoot then return end

    local oldPos = myRoot.CFrame
    local oldDestroyHeight = workspace.FallenPartsDestroyHeight

    local bv = Instance.new("BodyVelocity")
    bv.Parent = myRoot
    bv.Velocity = Vector3.new(0, 0, 0)
    bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)

    myHum:SetStateEnabled(Enum.HumanoidStateType.Seated, false)
    workspace.FallenPartsDestroyHeight = 0 / 0

    local startTime = tick()
    while Misc.Settings.flingActive and tick() - startTime < 3 do
        myRoot.CFrame = CFrame.new(targetRoot.Position) * CFrame.new(0, 1.5, 0)
            * CFrame.Angles(math.rad(math.random(0, 360)), 0, 0)
        myRoot.Velocity = Vector3.new(9e7, 9e7 * 10, 9e7)
        myRoot.RotVelocity = Vector3.new(9e8, 9e8, 9e8)
        RunService.Heartbeat:Wait()
    end

    bv:Destroy()
    myHum:SetStateEnabled(Enum.HumanoidStateType.Seated, true)
    workspace.FallenPartsDestroyHeight = oldDestroyHeight

    if oldPos then
        local t0 = tick()
        repeat
            myRoot.CFrame = oldPos * CFrame.new(0, 0.5, 0)
            myHum:ChangeState("GettingUp")
            for _, p in ipairs(myChar:GetChildren()) do
                if p:IsA("BasePart") then
                    p.Velocity = Vector3.zero
                    p.RotVelocity = Vector3.zero
                end
            end
            RunService.Heartbeat:Wait()
        until (myRoot.Position - oldPos.Position).Magnitude < 25 or tick() - t0 > 5
    end
end

function Misc.flingPlayer(target)
    if Misc.Settings.flingActive then return end
    if not target or not target.Parent or not target.Character then return end
    Misc.Settings.flingActive = true
    task.spawn(function()
        Logger.try("Misc.fling", skidFling, target)
        Misc.Settings.flingActive = false
        local cam = workspace.CurrentCamera
        if cam then
            local hum = Context.getHumanoid()
            if hum then cam.CameraSubject = hum end
        end
    end)
end

function Misc.flingRole(roleName)
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= Context.LocalPlayer and Roles.getFor(plr) == roleName then
            Misc.flingPlayer(plr)
            return true
        end
    end
    return false
end

local function stopDance()
    if Misc.Settings.currentDanceTrack then
        pcall(function()
            Misc.Settings.currentDanceTrack:Stop()
            Misc.Settings.currentDanceTrack:Destroy()
        end)
        Misc.Settings.currentDanceTrack = nil
    end
end

local function playDance()
    local char = Context.getCharacter()
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    local animator = hum:FindFirstChildOfClass("Animator")
    if not animator then
        animator = Instance.new("Animator")
        animator.Parent = hum
    end
    stopDance()
    task.wait(0.1)
    local anim = Instance.new("Animation")
    anim.AnimationId = "rbxassetid://" .. tostring(Misc.Settings.danceId)
    local ok = pcall(function()
        local track = animator:LoadAnimation(anim)
        track.Looped = true
        track.Priority = Enum.AnimationPriority.Action
        track:Play(0.1, 1, 1)
        Misc.Settings.currentDanceTrack = track
    end)
    anim:Destroy()
    if not ok then Logger.warn("Dance failed") end
end

function Misc.setDanceEnabled(enabled, danceName)
    Misc.Settings.danceEnabled = enabled
    if danceName and danceList[danceName] then
        Misc.Settings.danceId = danceList[danceName]
    end
    if enabled then playDance() else stopDance() end
end

function Misc.init(context)
    context.LocalPlayer.CharacterAdded:Connect(function()
        task.wait(0.5)
        if Misc.Settings.danceEnabled then playDance() end
    end)
end

