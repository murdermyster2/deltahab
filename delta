local Combat = {}
Combat.Settings = {
    autoKill = false,
    autoShoot = false,
    predictionMultiplier = 2.5,
}

local function getPing()
    local ok, v = pcall(function()
        return Stats.Network.ServerStatsItem["Data Ping"]:GetValue()
    end)
    return ok and v or 50
end

local function getKnife(context)
    local char = context.getCharacter()
    if not char then return nil end
    local knife = char:FindFirstChild("Knife")
    if knife then return knife end
    local backpack = context.LocalPlayer:FindFirstChild("Backpack")
    if backpack then
        knife = backpack:FindFirstChild("Knife")
        if knife then
            knife.Parent = char
            task.wait(0.1)
            return knife
        end
    end
    return nil
end

local function getGun(context)
    local char = context.getCharacter()
    if not char then return nil end
    local gun = char:FindFirstChild("Gun")
    if gun then return gun end
    local backpack = context.LocalPlayer:FindFirstChild("Backpack")
    if backpack then
        gun = backpack:FindFirstChild("Gun")
        if gun then
            gun.Parent = char
            task.wait(0.05)
            return gun
        end
    end
    return nil
end

local function stabPlayer(knife, target)
    if not knife or not target.Character then return end
    local head = target.Character:FindFirstChild("Head")
    if not head then return end
    local events = knife:FindFirstChild("Events")
    if not events then return end
    local stab = events:FindFirstChild("KnifeStabbed")
    local touch = events:FindFirstChild("HandleTouched")
    if stab then pcall(function() stab:FireServer() end) end
    if touch then pcall(function() touch:FireServer(head) end) end
end

local function computePredictedCFrame(targetRoot)
    local vel = targetRoot.Velocity
    local dt = (getPing() / 1000) * Combat.Settings.predictionMultiplier
    local speed = vel.Magnitude

    local aimPos
    if speed < 1 then
        aimPos = targetRoot.Position + targetRoot.CFrame.LookVector * 2
    else
        local mult = 1 + (speed / 50)
        aimPos = targetRoot.Position + vel * (dt * mult)
    end

    local origin = targetRoot.Position - targetRoot.CFrame.LookVector
    return CFrame.new(origin), CFrame.new(aimPos)
end

function Combat.init(context)
    Connection.newTagged(context, "autokill", RunService.Heartbeat, function()
        if not Combat.Settings.autoKill then return end
        if not context.isAlive() then return end

        local knife = getKnife(context)
        if not knife then return end

        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= context.LocalPlayer and plr.Character then
                if plr.Character:FindFirstChild("Head") then
                    stabPlayer(knife, plr)
                    task.wait(0.05)
                end
            end
        end
    end)

    Connection.newTagged(context, "autoshoot", RunService.Heartbeat, function()
        if not Combat.Settings.autoShoot then return end
        if not context.isAlive() then return end

        local murderer = nil
        for _, plr in ipairs(Players:GetPlayers()) do
            if Roles.getFor(plr) == "Murderer" then murderer = plr; break end
        end
        if not murderer or not murderer.Character then return end

        local gun = getGun(context)
        if not gun then return end

        local targetRoot = murderer.Character:FindFirstChild("HumanoidRootPart")
        if not targetRoot then return end

        local origin, aim = computePredictedCFrame(targetRoot)
        local shoot = gun:FindFirstChild("Shoot")
        if shoot and shoot:IsA("RemoteEvent") then
            pcall(function() shoot:FireServer(origin, aim) end)
        end
    end)
end

