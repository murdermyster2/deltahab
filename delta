        local path = CONFIG_FOLDER .. "/" .. currentConfig .. CONFIG_EXT
        local data = game:GetService("HttpService"):JSONEncode(gatherSettings())
        local ok, err = pcall(writefile, path, data)
        if ok then
            Window:Notify({ Title = "Сохранено", Description = currentConfig, Duration = 2 })
