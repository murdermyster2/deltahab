local Logger = {}
local LOG_PREFIX = "[Delta Hub]"
local LOG_LEVEL = 2
local LEVELS = { ERROR = 1, WARN = 2, INFO = 3 }

local function joinArgs(...)
    local t = {}
    for i = 1, select("#", ...) do
        t[i] = tostring((select(i, ...)))
    end
    return table.concat(t, " ")
end

function Logger.log(level, ...)
    if LOG_LEVEL < LEVELS[level] then return end
    local text = ("%s [%s] %s"):format(LOG_PREFIX, level, joinArgs(...))
    if level == "ERROR" then warn(text) else print(text) end
end

function Logger.error(...) Logger.log("ERROR", ...) end
function Logger.warn(...)  Logger.log("WARN", ...)  end
function Logger.info(...)  Logger.log("INFO", ...)  end

function Logger.try(label, fn, ...)
    local ok, res = pcall(fn, ...)
    if not ok then Logger.error(("%s failed: %s"):format(label, tostring(res))) end
    return ok, res
end

