local AutoFarm = {}
AutoFarm.State = {
    farming = false,
    allCollected = false,
    currentCoins = 0,
    maxCoins = 0,
    noclipConn = nil,
    originalParts = {},
    currentTween = nil,
    farmGravity = nil,
    farmStartTime = 0,
}

local function returnCoinContainer()
    for _, m in ipairs(workspace:GetChildren()) do
        if m:IsA("Model") then
            local cc = m:FindFirstChild("CoinContainer")
            if cc then return cc end
        end
    end
    return nil
end

local function findNearestCoin(container)
    if not container then return nil, math.huge end
    local root = Context.getRootPart()
    if not root then return nil, math.huge end
    local best, bestDist = nil, math.huge
    for _, coin in ipairs(container:GetChildren()) do
        if coin:GetAttribute("CoinID") == "Candy"
            and coin:FindFirstChild("TouchInterest")
            and coin.Transparency == 1 then
            local d = (root.Position - coin.Position).Magnitude
            if d < bestDist then best, bestDist = coin, d end
        end
    end
    return best, bestDist
end

local function restoreGravity()
    local root = Context.getRootPart()
    if root then
        for _, c in ipairs(root:GetChildren()) do
            if c:IsA("BodyVelocity") or c:IsA("BodyGyro")
                or c:IsA("BodyPosition") or c:IsA("BodyForce") then
                c:Destroy()
            end
        end
    end
end

local function stopFarming()
    AutoFarm.State.farming = false
    if AutoFarm.State.noclipConn then
        AutoFarm.State.noclipConn:Disconnect()
        AutoFarm.State.noclipConn = nil
    end
    if AutoFarm.State.currentTween then
        pcall(function() AutoFarm.State.currentTween:Cancel() end)
        AutoFarm.State.currentTween = nil
    end
    local char = Context.getCharacter()
    if char then
        for part, props in pairs(AutoFarm.State.originalParts) do
            if part and part.Parent then
                part.CanCollide = props.CanCollide
                part.Massless = props.Massless
            end
        end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then hum.PlatformStand = false end
    end
    AutoFarm.State.originalParts = {}
    restoreGravity()
end

local function startFarming()
    local char = Context.getCharacter()
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not root or not hum then return end

    AutoFarm.State.originalParts = {}
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            AutoFarm.State.originalParts[part] = {
                CanCollide = part.CanCollide,
                Massless = part.Massless,
            }
        end
    end

    if root:FindFirstChild("FarmGravity") then
        root.FarmGravity:Destroy()
    end
    local bp = Instance.new("BodyPosition")
    bp.Name = "FarmGravity"
    bp.MaxForce = Vector3.new(0, math.huge, 0)
    bp.D = 1000
    bp.P = 10000
    bp.Position = root.Position
    bp.Parent = root
    AutoFarm.State.farmGravity = bp

    root.CFrame = root.CFrame - Vector3.new(0, 2.5, 0)
    root.CFrame = root.CFrame * CFrame.Angles(math.rad(90), 0, 0)

    hum.PlatformStand = true
    hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
    hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)

    AutoFarm.State.farming = true

    if not AutoFarm.State.noclipConn then
        AutoFarm.State.noclipConn = RunService.Stepped:Connect(function()
            if AutoFarm.State.farming and Context.getCharacter() then
                for _, part in ipairs(Context.getCharacter():GetDescendants()) do
                    if part:IsA("BasePart") then part.CanCollide = false end
                end
            end
        end)
    end
end

local function farmTick()
    if not AutoFarm.State.farming then return end
    if not Context.isAlive() then
        stopFarming()
        return
    end

    local root = Context.getRootPart()
    local container = returnCoinContainer()
    if not root or not container then
        stopFarming()
        return
    end

    local coin = findNearestCoin(container)
    if not coin then
        stopFarming()
        return
    end

    local distance = (root.Position - coin.Position).Magnitude
    if distance <= 7.5 then
        pcall(function()
            firetouchinterest(root, coin, 0)
            firetouchinterest(root, coin, 1)
        end)
    end
end

function AutoFarm.init(context)
    local gameplay = ReplicatedStorage:FindFirstChild("Remotes")
        and ReplicatedStorage.Remotes:FindFirstChild("Gameplay")
    if gameplay then
        local coinCollected = gameplay:FindFirstChild("CoinCollected")
        if coinCollected then
            coinCollected.OnClientEvent:Connect(function(coinType, current, max)
                if coinType == "Candy" or coinType == "Coin" then
                    AutoFarm.State.currentCoins = tonumber(current) or 0
                    AutoFarm.State.maxCoins = tonumber(max) or 0
                    if AutoFarm.State.currentCoins >= AutoFarm.State.maxCoins
                        and AutoFarm.State.maxCoins > 0 then
                        AutoFarm.State.allCollected = true
                        if AutoFarm.State.farming then stopFarming() end
                    else
                        AutoFarm.State.allCollected = false
                    end
                end
            end)
        end
        local roundStart = gameplay:FindFirstChild("RoundStart")
        if roundStart then
            roundStart.OnClientEvent:Connect(function()
                AutoFarm.State.allCollected = false
                AutoFarm.State.currentCoins = 0
                AutoFarm.State.maxCoins = 0
                if AutoFarm.State.farming then stopFarming() end
            end)
        end
        local roundEnd = gameplay:FindFirstChild("RoundEndFade")
        if roundEnd then
            roundEnd.OnClientEvent:Connect(function()
                AutoFarm.State.allCollected = false
                AutoFarm.State.currentCoins = 0
                AutoFarm.State.maxCoins = 0
                if AutoFarm.State.farming then stopFarming() end
            end)
        end
    end

    Connection.newTagged(context, "autofarm", RunService.Heartbeat, function()
        if not context.State.autoFarmEnabled then
            if AutoFarm.State.farming then stopFarming() end
            return
        end
        if AutoFarm.State.allCollected then
            if AutoFarm.State.farming then stopFarming() end
            return
        end
        local role = Roles.getFor(context.LocalPlayer)
        if not role then return end
        if role == "Murderer" then
            if AutoFarm.State.farming then stopFarming() end
            return
        end
        if not Context.isAlive() then return end

        local container = returnCoinContainer()
        if not container then return end
        local coin = findNearestCoin(container)
        if not coin then
            if AutoFarm.State.farming then stopFarming() end
            return
        end

        if not AutoFarm.State.farming then startFarming() end

        local root = Context.getRootPart()
        if not root then return end
        root.Velocity = Vector3.new(0, 0, 0)
        root.RotVelocity = Vector3.new(0, 0, 0)

        local targetPos = coin.Position - Vector3.new(0, 2.5, 0)
        local targetCF = CFrame.new(targetPos) * CFrame.Angles(math.rad(90), 0, 0)
        local dist = (root.Position - targetPos).Magnitude
        local info = TweenInfo.new(dist / 23, Enum.EasingStyle.Linear, Enum.EasingDirection.Out)

        if AutoFarm.State.currentTween then
            pcall(function() AutoFarm.State.currentTween:Cancel() end)
        end
        AutoFarm.State.currentTween = TweenService:Create(root, info, { CFrame = targetCF })
        AutoFarm.State.currentTween:Play()
    end)

    Connection.newTagged(context, "autofarm", RunService.Heartbeat, function()
        if AutoFarm.State.farming then farmTick() end
    end)
end

function AutoFarm.start(context)
    context.State.autoFarmEnabled = true
    AutoFarm.State.farmStartTime = os.time()
end

function AutoFarm.stop(context)
    context.State.autoFarmEnabled = false
    stopFarming()
end

