local function gatherSettings()
    return {
        combat = Combat.Settings,
        esp = ESP.Settings,
        visuals = Visuals.Settings,
        misc = { danceEnabled = Misc.Settings.danceEnabled, danceId = Misc.Settings.danceId },
        state = Context.State,
    }
end

local function applySettings(s)
    if type(s) ~= "table" then return end
    for k, v in pairs(s.combat or {}) do Combat.Settings[k] = v end
    for k, v in pairs(s.esp or {}) do ESP.Settings[k] = v end
    for k, v in pairs(s.visuals or {}) do Visuals.Settings[k] = v end
    if s.misc then
        Misc.Settings.danceEnabled = s.misc.danceEnabled
        Misc.Settings.danceId = s.misc.danceId or Misc.Settings.danceId
    end
    for k, v in pairs(s.state or {}) do Context.State[k] = v end
end

