local Connection = {}
Connection.__index = Connection

local tagRegistry = {}

function Connection.new(context, signal, callback)
    local self = setmetatable({}, Connection)
    self.conn = signal:Connect(callback)
    self.active = true
    table.insert(context.Connections, self)
    return self
end

function Connection.newTagged(context, tag, signal, callback)
    local self = Connection.new(context, signal, callback)
    tagRegistry[tag] = tagRegistry[tag] or {}
    table.insert(tagRegistry[tag], self)
    return self
end

function Connection:disconnect()
    if self.active and self.conn then
        self.conn:Disconnect()
        self.active = false
    end
end

function Connection.disconnectAll(context)
    for _, c in ipairs(context.Connections) do c:disconnect() end
    table.clear(context.Connections)
    for tag in pairs(tagRegistry) do tagRegistry[tag] = nil end
end

function Connection.disconnectTag(tag)
    local list = tagRegistry[tag]
    if not list then return end
    for _, c in ipairs(list) do c:disconnect() end
    tagRegistry[tag] = nil
end

